@page "/dashboard"
@using ArtemioBlazorWA.Models
@using ArtemioBlazorWA.Services;

@inject DashboardService _dashboardService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ISnackbar Snackbar

@if (isLoading)
{
    <FormSkeleton Rows="1" Columns="3" />
}
else
{
<MudGrid Justify="Justify.Center" Style="align-items: center;">

    <MudItem xs="2">
        <MudPaper Class="d-flex flex-column justify-space-between flex-grow-1 gap-4 pa-6 my-6" Elevation="1">
            <MudText Typo="Typo.body1" Align="Align.Center" GutterBottom="true">Total Booking</MudText>
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">@totalBooking</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="2">
        <MudPaper Class="d-flex flex-column justify-space-between flex-grow-1 gap-4 pa-6 my-6" Elevation="1">
            <MudText Typo="Typo.body1" Align="Align.Center" GutterBottom="true">Total Containers Request</MudText>
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">@totalContainers</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="2">
        <MudPaper Class="d-flex flex-column justify-center flex-grow-1 gap-4 pa-6 my-6" Elevation="1">
            <MudText Typo="Typo.body1" Align="Align.Center" GutterBottom="true">Total Containers Real</MudText>
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">@totalContainersReal</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>
}

<EntityGridPage T="BookingDashboard"
                 Title="Booking Summary"
                 Items="@bdList"
                 IsLoading="@isLoading"
                 @bind-SearchString="_searchString"
                 ShowCreateButton="false"
                 EmptyMessage="No hay bookings para esta season.">
    <Columns>
        <PropertyColumn Property="x => x.LastETD" Title="ETD" />
        <PropertyColumn Property="x => x.LastETA" Title="ETA" />
        <PropertyColumn Property="x => x.ContractType" Title="Contract Type" />
        <PropertyColumn Property="x => x.WK" Title="WK" />
        <PropertyColumn Property="x => x.StatusBL" Title="StatusBL" />
        <PropertyColumn Property="x => x.PoRef" Title="POREF" />
        <PropertyColumn Property="x => x.Shipper" Title="Shipper" />
        <PropertyColumn Property="x => x.NroRequest" Title="NroRequest" />
        <PropertyColumn Property="x => x.NroBooking" Title="NroBooking" />
        <PropertyColumn Property="x => x.QtyContainers" Title="Qty Request" />
        <PropertyColumn Property="x => x.QtyContainersReal" Title="Qty Real" />
    </Columns>
</EntityGridPage>

@code {
    List<BookingDashboard> bdList = new();
    private string _searchString;
    private bool _sortNameByLength;
    bool isLoading = true;
    private int seasonId = 0;
    private int totalBooking=0;
    private int totalContainers = 0;
    private int totalContainersReal = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            seasonId = await localStorage.GetItemAsync<int>("season");

            await localStorage.SetItemAsync<string>("last", "dashboard");

            isLoading = true;
            bdList = await _dashboardService.GetAllAsync(seasonId);

            if (bdList == null)
            {
                bdList = new List<BookingDashboard>();
            }

            totalBooking = bdList.Count();
            totalContainers = bdList.Sum(s => s.QtyContainers);
            totalContainersReal = bdList.Sum(s => s.QtyContainersReal);

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isLoading = false;
            Snackbar.Add("No se pudo cargar la informacion. Intenta nuevamente.", Severity.Error);
            StateHasChanged();
        }
    }
}
