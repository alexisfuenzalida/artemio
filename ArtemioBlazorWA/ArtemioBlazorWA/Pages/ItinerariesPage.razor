        */

        itineraryList = await _itineraryService.GetAllAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await localStorage.SetItemAsync<string>("last", "itineraries");
            isLoading = true;
            seasonId = await localStorage.GetItemAsync<int>("season");

            await FillData();

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isLoading = false;
            Snackbar.Add("No se pudo cargar la informacion. Intenta nuevamente.", Severity.Error);
            StateHasChanged();
        }
    }

    private async Task OpenFilterDialog()
    {
        var parameters = new DialogParameters<ItineraryFilterForm>();
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ItineraryFilterForm>("Filter Contract", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            isLoading = true;

            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OpenImportDialog()
    {
        var parameters = new DialogParameters<ItineraryImportForm>();
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ItineraryImportForm>("Import Itineraries", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            isLoading = true;

            await FillData();

            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OpenDialog(int id)
    {
        var parameters = new DialogParameters<ItineraryForm> { { x => x.id, id } };
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true, BackdropClick = false, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ItineraryForm>("itinerary", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            isLoading = true;

            await FillData();

            isLoading = false;
            StateHasChanged();
        }
    }

    private async void OnDelete(int id)
    {
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false, FullWidth = true };

        bool? result = await DialogService.ShowMessageBox(
            "Delete",
            "Confirm to delete item?",
            yesText: "Delete", cancelText: "Cancel", options: options);

        if (result == true)
        {
            var x = await _itineraryService.DeleteAsync(id);
            //itineraryList = await _itineraryService.GetAllAsync();
            isLoading = true;

            await FillData();

            isLoading = false;
            StateHasChanged();
        }

        StateHasChanged();
    }

    private async void OnDuplicate(int id)
    {
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false, FullWidth = true };

        bool? result = await DialogService.ShowMessageBox(
            "Duplicate",
            "Confirm to duplicate itinerary?",
            yesText: "Duplicate", cancelText: "Cancel", options: options);

        if (result == true)
        {
            isLoading = true;
            var x = await _itineraryService.PostCopyAsync(id, 7);

            Show("Duplicate Success", Severity.Info);

            await FillData();

            isLoading = false;
        }

        StateHasChanged();
    }

    private Func<ItineraryGrid, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.Week.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            x.ETD.Value.ToShortDateString().Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            x.TransportCompany.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            x.Service.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            x.Vessel.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            x.POL.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };

    private Snackbar _snackbar;

    void Show(string msg, Severity severity)
    {
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomCenter;
        _snackbar = Snackbar.Add(msg, severity);
    }
}
