@page "/itineraries"

@using ArtemioBlazorWA.Forms;
@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject ItineraryService _itineraryService
@inject ServiceService _serviceService
@inject TransportCompanyService _transportcompanyService
@inject VesselService _vesselService
@inject PortService _portService
@inject FilterService _filterService

@inject IDialogService DialogService
@inject Blazored.LocalStorage.ILocalStorageService localStorage

@inject ISnackbar Snackbar

<EntityGridPage T="ItineraryGrid"
                 Title="Itinerary"
                 Items="@itineraryList"
                 IsLoading="@isLoading"
                 @bind-SearchString="_searchString"
                 QuickFilter="@_quickFilter"
                 CreateLabel="Create"
                 OnCreate="@(() => OpenDialog(0))"
                 EmptyMessage="No hay itinerarios.">
    <HeaderActions>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.UploadFile"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   OnClick="@(() => OpenImportDialog())">
            Import Excel
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   OnClick="@(() => OpenFilterDialog())">
            Download
        </MudButton>
    </HeaderActions>
    <Columns>
        <PropertyColumn Property="x => x.Week" Filterable="false" />
        <PropertyColumn Property="x => x.ETD!.Value.ToShortDateString()" Title="ETD" Filterable="false" />
        <PropertyColumn Property="x => x.TransportCompany" Title="ShippingCompany" Filterable="false" />
        <PropertyColumn Property="x => x.Service" Filterable="false" />
        <PropertyColumn Property="x => x.Vessel" Filterable="false" />
        <PropertyColumn Property="x => x.POL" Filterable="false" />
        <TemplateColumn CellClass="d-flex justify-center" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudStack Row>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                        <MudMenuItem OnClick="@(() => OpenDialog(context.Item.ItineraryId))" Icon="@Icons.Material.Filled.Edit" IconSize="Size.Small">Edit</MudMenuItem>
                        <MudMenuItem OnClick="@(() => OnDuplicate(context.Item.ItineraryId))" Icon="@Icons.Material.Filled.CopyAll" IconSize="Size.Small">Duplicate</MudMenuItem>
                        <MudMenuItem OnClick="@(() => OnDelete(context.Item.ItineraryId))" Icon="@Icons.Material.Filled.Delete" IconSize="Size.Small">Delete</MudMenuItem>
                    </MudMenu>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</EntityGridPage>


@code {
    List<ItineraryGrid> itineraryList = new();

    private List<TransportCompanyModel> transportcompanyList = new();
    private List<VesselModel> vesselList = new();
    private List<ItineraryModel> itinerary = new();
    private List<PortModel> polList = new();
    private List<ServiceModel> serviceList = new();

    private string Email = "";

    private int seasonId = 0;

    private string _searchString;
    private bool _sortNameByLength;
    bool isLoading = true;
    List<ItineraryGrid> selectedItinerary = new();

    async Task FillData()
    {
        /*
