@page "/statuscontainers"

@using ArtemioBlazorWA.Forms;
@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject StatusContainerService _statuscontainerService
@inject IDialogService DialogService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ISnackbar Snackbar

<EntityGridPage T="StatusContainerModel"
                 Title="Status Containers"
                 Items="@statuscontainerList"
                 IsLoading="@isLoading"
                 @bind-SearchString="_searchString"
                 QuickFilter="@_quickFilter"
                 CreateLabel="Create"
                 OnCreate="@(() => OpenDialog(new StatusContainerModel()))"
                 EmptyMessage="No hay resultados.">
    <Columns>
             <PropertyColumn Property="x => x.StatusContainerId" Title="Id" />
             <PropertyColumn Property="x => x.StatusContainer" Title="StatusContainer" />
             <TemplateColumn CellClass="d-flex justify-center" Sortable="false" Filterable="false">
                 <CellTemplate>
                     <MudStack Row>
                     <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                         <MudMenuItem OnClick="@(() => OpenDialog(context.Item))" Icon="@Icons.Material.Filled.Edit" IconSize="Size.Small">Edit</MudMenuItem>
                         <MudMenuItem OnClick="@(() => OnDelete(context.Item.StatusContainerId))" Icon="@Icons.Material.Filled.Delete" IconSize="Size.Small">Delete</MudMenuItem>
                     </MudMenu>
                 </MudStack>
             </CellTemplate>
         </TemplateColumn>
    </Columns>
</EntityGridPage>


@code {
    List<StatusContainerModel> statuscontainerList = new();
    private StatusContainerModel data = new();
    private string _searchString;
    private bool _sortNameByLength;
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await localStorage.SetItemAsync<string>("last", "statuscontainers");
            isLoading = true;
            statuscontainerList = await _statuscontainerService.GetAllAsync();
            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isLoading = false;
            Snackbar.Add("No se pudo cargar la informacion. Intenta nuevamente.", Severity.Error);
            StateHasChanged();
        }
    }

    private async Task OpenDialog(StatusContainerModel s)
    {
        var parameters = new DialogParameters<StatusContainerForm> { { x => x.statuscontainer, s } };
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseButton = true };
        var dialog = await DialogService.ShowAsync<StatusContainerForm>("StatusContainer", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            statuscontainerList = await _statuscontainerService.GetAllAsync();
        }
    }

    private async void OnDelete(int id)
    {
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false, FullWidth = true };

        bool? result = await DialogService.ShowMessageBox(
            "Delete",
            "Confirm to delete item?",
            yesText: "Delete", cancelText: "Cancel", options: options);

        if (result == true)
        {
            try
            {
                isLoading = true;
                StateHasChanged();

                    var x = await _statuscontainerService.DeleteAsync(id);
                    statuscontainerList = await _statuscontainerService.GetAllAsync();

            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
                Snackbar.Add("No se pudo eliminar el registro. Intenta nuevamente.", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }

        StateHasChanged();
    }

    private Func<StatusContainerModel, object> _sortBy => x =>
    {
        if (_sortNameByLength)
            return x.StatusContainer.Length;
        else
            return x.StatusContainer;
    };

    private Func<StatusContainerModel, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.StatusContainer.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };
}
