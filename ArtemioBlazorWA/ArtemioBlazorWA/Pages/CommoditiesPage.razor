@page "/commodities"

@using ArtemioBlazorWA.Forms;
@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject CommodityService _commodityService
@inject IDialogService DialogService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ISnackbar Snackbar

<EntityGridPage T="CommodityModel"
                 Title="Commodities"
                 Items="@commodityList"
                 IsLoading="@isLoading"
                 @bind-SearchString="_searchString"
                 QuickFilter="@_quickFilter"
                 CreateLabel="Create"
                 OnCreate="@(() => OpenDialog(new CommodityModel()))"
                 EmptyMessage="No hay resultados.">
    <Columns>
            <PropertyColumn Property="x => x.CommodityId" Title="Id" />
            <PropertyColumn Property="x => x.Code" Title="Code" />
            <PropertyColumn Property="x => x.Commodity" Title="Commodity" />
            <TemplateColumn CellClass="d-flex justify-center" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudStack Row>
                     <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                         <MudMenuItem OnClick="@(() => OpenDialog(context.Item))" Icon="@Icons.Material.Filled.Edit" IconSize="Size.Small">Edit</MudMenuItem>
                         <MudMenuItem OnClick="@(() => OnDelete(context.Item.CommodityId))" Icon="@Icons.Material.Filled.Delete" IconSize="Size.Small">Delete</MudMenuItem>
                     </MudMenu>
                 </MudStack>
             </CellTemplate>
         </TemplateColumn>
    </Columns>
</EntityGridPage>


@code {
    List<CommodityModel> commodityList = new();
    private CommodityModel data = new();
    private string _searchString;
    private bool _sortNameByLength;
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await localStorage.SetItemAsync<string>("last", "commodities");
            isLoading = true;
            commodityList = await _commodityService.GetAllAsync();

            if (commodityList == null)
            {
                commodityList = new List<CommodityModel>();
            }

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isLoading = false;
            Snackbar.Add("No se pudo cargar la informacion. Intenta nuevamente.", Severity.Error);
            StateHasChanged();
        }
    }

    private async Task OpenDialog(CommodityModel s)
    {
        var parameters = new DialogParameters<CommodityForm> { { x => x.commodity, s } };
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseButton = true };
        var dialog = await DialogService.ShowAsync<CommodityForm>("commodity", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            commodityList = await _commodityService.GetAllAsync();
        }
    }

    private async void OnDelete(int id)
    {
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false, FullWidth = true };

        bool? result = await DialogService.ShowMessageBox(
            "Delete",
            "Confirm to delete item?",
            yesText: "Delete", cancelText: "Cancel", options: options);

        if (result == true)
        {
            try
            {
                isLoading = true;
                StateHasChanged();

                    var x = await _commodityService.DeleteAsync(id);
                    commodityList = await _commodityService.GetAllAsync();

            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
                Snackbar.Add("No se pudo eliminar el registro. Intenta nuevamente.", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }

        StateHasChanged();
    }

    private Func<CommodityModel, object> _sortBy => x =>
    {
        if (_sortNameByLength)
            return x.Commodity.Length;
        else
            return x.Commodity;
    };

    private Func<CommodityModel, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.Commodity.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };
}
