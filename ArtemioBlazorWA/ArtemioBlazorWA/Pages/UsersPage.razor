@page "/users"

@using ArtemioBlazorWA.Forms;
@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject UserService _userService
@inject IDialogService DialogService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ISnackbar Snackbar

<EntityGridPage T="UserModel"
                 Title="Users"
                 Items="@userList"
                 IsLoading="@isLoading"
                 @bind-SearchString="_searchString"
                 QuickFilter="@_quickFilter"
                 CreateLabel="Create"
                 OnCreate="@(() => OpenDialog(new UserModel()))"
                 EmptyMessage="No hay resultados.">
    <Columns>
            <PropertyColumn Property="x => x.UserId" Title="Id" />
            <PropertyColumn Property="x => x.User" Title="User" />
            <PropertyColumn Property="x => x.Email" Title="Email" />
            <PropertyColumn Property="x => x.Type" Title="Type" />
            <TemplateColumn CellClass="d-flex justify-center" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudStack Row>
                     <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                         <MudMenuItem OnClick="@(() => OpenDialog(context.Item))" Icon="@Icons.Material.Filled.Edit" IconSize="Size.Small">Edit</MudMenuItem>
                         <MudMenuItem OnClick="@(() => OnDelete(context.Item.UserId))" Icon="@Icons.Material.Filled.Delete" IconSize="Size.Small">Delete</MudMenuItem>
                     </MudMenu>
                 </MudStack>
             </CellTemplate>
         </TemplateColumn>
    </Columns>
</EntityGridPage>


@code {
    List<UserModel> userList = new();
    private UserModel data = new();
    private string _searchString;
    private bool _sortNameByLength;
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await localStorage.SetItemAsync<string>("last", "users");
            isLoading = true;
            userList = await _userService.GetAllAsync();

            if (userList == null)
            {
                userList = new List<UserModel>();
            }

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isLoading = false;
            Snackbar.Add("No se pudo cargar la informacion. Intenta nuevamente.", Severity.Error);
            StateHasChanged();
        }
    }

    private async Task OpenDialog(UserModel s)
    {
        var parameters = new DialogParameters<UserForm> { { x => x.user, s } };
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseButton = true };
        var dialog = await DialogService.ShowAsync<UserForm>("user", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            userList = await _userService.GetAllAsync();
        }
    }

    private async void OnDelete(int id)
    {
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false, FullWidth = true };

        bool? result = await DialogService.ShowMessageBox(
            "Delete",
            "Confirm to delete item?",
            yesText: "Delete", cancelText: "Cancel", options: options);

        if (result == true)
        {
            try
            {
                isLoading = true;
                StateHasChanged();

                    var x = await _userService.DeleteAsync(id);
                    userList = await _userService.GetAllAsync();

            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
                Snackbar.Add("No se pudo eliminar el registro. Intenta nuevamente.", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }

        StateHasChanged();
    }

    private Func<UserModel, object> _sortBy => x =>
    {
        if (_sortNameByLength)
            return x.User.Length;
        else
            return x.User;
    };

    private Func<UserModel, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.User.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };
}
