@page "/containerstype"

@using ArtemioBlazorWA.Forms;
@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject ContainerTypeService _containertypeService
@inject IDialogService DialogService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ISnackbar Snackbar

<EntityGridPage T="ContainerTypeModel"
                 Title="Containers Type"
                 Items="@containertypeList"
                 IsLoading="@isLoading"
                 @bind-SearchString="_searchString"
                 QuickFilter="@_quickFilter"
                 CreateLabel="Create"
                 OnCreate="@(() => OpenDialog(new ContainerTypeModel()))"
                 EmptyMessage="No hay resultados.">
    <Columns>
            <PropertyColumn Property="x => x.ContainerTypeId" Title="Id" />
            <PropertyColumn Property="x => x.ContainerType" Title="ContainerType" />
            <TemplateColumn CellClass="d-flex justify-center" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudStack Row>
                     <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                         <MudMenuItem OnClick="@(() => OpenDialog(context.Item))" Icon="@Icons.Material.Filled.Edit" IconSize="Size.Small">Edit</MudMenuItem>
                         <MudMenuItem OnClick="@(() => OnDelete(context.Item.ContainerTypeId))" Icon="@Icons.Material.Filled.Delete" IconSize="Size.Small">Delete</MudMenuItem>
                     </MudMenu>
                 </MudStack>
             </CellTemplate>
         </TemplateColumn>
    </Columns>
</EntityGridPage>


@code {
    List<ContainerTypeModel> containertypeList = new();
    private ContainerTypeModel data = new();
    private string _searchString;
    private bool _sortNameByLength;
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await localStorage.SetItemAsync<string>("last", "containerstype");
            isLoading = true;
            containertypeList = await _containertypeService.GetAllAsync();

            if (containertypeList == null)
            {
                containertypeList = new List<ContainerTypeModel>();
            }

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isLoading = false;
            Snackbar.Add("No se pudo cargar la informacion. Intenta nuevamente.", Severity.Error);
            StateHasChanged();
        }
    }

    private async Task OpenDialog(ContainerTypeModel s)
    {
        var parameters = new DialogParameters<ContainerTypeForm> { { x => x.containertype, s } };
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ContainerTypeForm>("containertype", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            containertypeList = await _containertypeService.GetAllAsync();
        }
    }

    private async void OnDelete(int id)
    {
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false, FullWidth = true };

        bool? result = await DialogService.ShowMessageBox(
            "Delete",
            "Confirm to delete item?",
            yesText: "Delete", cancelText: "Cancel", options: options);

        if (result == true)
        {
            try
            {
                isLoading = true;
                StateHasChanged();

                    var x = await _containertypeService.DeleteAsync(id);
                    containertypeList = await _containertypeService.GetAllAsync();

            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
                Snackbar.Add("No se pudo eliminar el registro. Intenta nuevamente.", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }

        StateHasChanged();
    }

    private Func<ContainerTypeModel, object> _sortBy => x =>
    {
        if (_sortNameByLength)
            return x.ContainerType.Length;
        else
            return x.ContainerType;
    };

    private Func<ContainerTypeModel, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.ContainerType.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };
}
