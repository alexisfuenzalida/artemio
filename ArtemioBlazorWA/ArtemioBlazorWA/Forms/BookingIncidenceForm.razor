@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject ISnackbar Snackbar
@inject BookingIncidenceService _bookingincidenceService
@inject IncidenceTypeService _incidencetypeService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Incidences
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <GridSkeleton />
        }
        else
        {

        <MudGrid>
            <MudItem xs="12">
                <MudCard Elevation="2">
                    <MudCardHeader Style="background-color: var(--mud-palette-background);">
                        <CardHeaderContent>
                            <MudText Typo="Typo.body1">Booking Details - @Container</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudButton Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Color="Color.Primary"
                                       OnClick="@(() => AddRow(new BookingIncidenceModel()))">
                                Add Row
                            </MudButton>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudItem xs="12">
                            <MudTable Items="@bookingincidenceList" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Primary">
                                <HeaderContent>
                                    <MudTh></MudTh>
                                    <MudTh></MudTh>
                                    <MudTh></MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Incidence Type">
                                        <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" T="int" Label="Incidence Type" @bind-Value="context.IncidenceTypeId" Required="true" RequiredError="Incidence type is required!"
                                                   ToStringFunc="@(id => incidencetypeList.FirstOrDefault(t => t.IncidenceTypeId == id)?.IncidenceType)">
                                            @foreach (var item in incidencetypeList)
                                            {
                                                <MudSelectItem T="int" Value="@item.IncidenceTypeId">@item.IncidenceType</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudTd>
                                    <MudTd DataLabel="Date">
                                        <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="context.Date" Label="Date" />
                                    </MudTd>
                                    <MudTd DataLabel="Incidence">
                                        <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="context.Incidence" Label="Incidence" />
                                    </MudTd>
                                    <MudTd DataLabel="Remove">
                                        <MudFab StartIcon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveDtl(context))" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudItem>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
            }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="@_processing" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public List<BookingIncidenceModel> bookingincidenceList { get; set; } = new List<BookingIncidenceModel>();
    [Parameter] public string Container { get; set; } = "";
    [Parameter] public int BookingId { get; set; } = 0;

    private List<IncidenceTypeModel> incidencetypeList = new();
    private bool _processing = false;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {

        incidencetypeList = await _incidencetypeService.GetAllAsync();
        isLoading = false;
    }
    private void AddRow(BookingIncidenceModel bi)
    {
        bi.Container = Container;
        bi.BookingId = BookingId;
        bi.Date = DateTime.Now;
        bi.Incidence = "";

        bi.IncidenceTypeId = incidencetypeList.FirstOrDefault().IncidenceTypeId;

        bookingincidenceList.Add(bi);
    }

    private void RemoveDtl(BookingIncidenceModel bi)
    {
        bookingincidenceList.Remove(bi);
    }

    private async Task Submit()
    {
        var x = new BookingIncidenceModel();

        _processing = true;

        await _bookingincidenceService.DeleteAsync(BookingId,Container);

        foreach(var item in bookingincidenceList)
        {      
            x = await _bookingincidenceService.PostAsync(item);
        }

        _processing = false;
        if (x == null)
        {
            Snackbar.Add("Could not save. Please try again.", Severity.Error);
            return;
        }
        MudDialog.Close(true);
    }

    void Cancel() => MudDialog.Cancel();
}
