@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject ISnackbar Snackbar
@inject CommodityService _commodityService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Commodity
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <FormSkeleton Rows="3" />
        }
        else
        {
<MudForm @ref="form">

        <MudItem xs="12">
            <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="commodity.Code" Label="Code" Required="true" RequiredError="Code is required!" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="commodity.Commodity" Label="Commodity" Required="true" RequiredError="Commodity is required!" />
        </MudItem>
            </MudForm>
            }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="@_processing" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public CommodityModel commodity { get; set; } = new CommodityModel();

    private bool _processing = false;
    private MudForm? form;
    private bool isLoading = false;

    private async Task Submit()
    {

        if (form is not null)
        {
            await form.Validate();
            if (!form.IsValid)
            {
                return;
            }
        }
        var x = new CommodityModel();

        _processing = true;

        if (commodity.CommodityId == 0)
        {
            x = await _commodityService.PostAsync(commodity);
        }
        else
        {
            x = await _commodityService.PutAsync(commodity);
        }

        _processing = false;
        if (x == null)
        {
            Snackbar.Add("Could not save. Please try again.", Severity.Error);
            return;
        }
        MudDialog.Close(true);
    }

    void Cancel() => MudDialog.Cancel();
}
