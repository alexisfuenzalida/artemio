@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject SeasonSerice _seasonService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Season
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <FormSkeleton Rows="3" />
        }
        else
        {
<MudForm @ref="form">

        <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="season.Season" Label="Season" Required="true" RequiredError="Season is required!" />
            </MudForm>
            }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="@_processing" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public SeasonModel season { get; set; } = new SeasonModel();

    private bool _processing = false;
    private MudForm? form;
    private bool isLoading = false;
    private async Task Submit()
    {

        if (form is not null)
        {
            await form.Validate();
            if (!form.IsValid)
            {
                return;
            }
        }
        var x = new SeasonModel();

        if (season.SeasonId==0)
        {
            x = await _seasonService.PostAsync(season);

        }
        else
        {
            x = await _seasonService.PutAsync(season);
        }

        MudDialog.Close(true);
    }

        void Cancel() => MudDialog.Cancel();
}
