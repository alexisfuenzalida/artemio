@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject ISnackbar Snackbar
@inject CountryService _countryService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Country
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <FormSkeleton Rows="3" />
        }
        else
        {
<MudForm @ref="form">

        <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="country.Country" Label="Country" Required="true" RequiredError="Country is required!" />
        <MudTextField Class="mt-3"
                      Variant="Variant.Outlined"
                      T="string"
                      @bind-Value="country.FreeDaysComment"
                      Label="Free Days Comment"
                      Lines="3" />
            </MudForm>
            }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="@_processing" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public CountryModel country { get; set; } = new CountryModel();

    private bool _processing = false;
    private MudForm? form;
    private bool isLoading = false;

    private async Task Submit()
    {

        if (form is not null)
        {
            await form.Validate();
            if (!form.IsValid)
            {
                return;
            }
        }
        var x = new CountryModel();

        _processing = true;

        if (country.CountryId == 0)
        {
            x = await _countryService.PostAsync(country);
        }
        else
        {
            x = await _countryService.PutAsync(country);
        }

        _processing = false;
        if (x == null)
        {
            Snackbar.Add("Could not save. Please try again.", Severity.Error);
            return;
        }
        MudDialog.Close(true);
    }

    void Cancel() => MudDialog.Cancel();
}
