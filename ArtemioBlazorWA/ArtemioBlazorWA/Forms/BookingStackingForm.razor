@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;
@using System.Globalization;

@inject StackingService _stackingService
@inject BookingService _bookingService

@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Booking Stacking
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <GridSkeleton />
        }
        else
        {

        <MudGrid>
            <MudItem xs="12">
                <MudDataGrid T="BookingStackingGrid"
                             Items="@bookingStackingList"
                             Filterable="true"
                             QuickFilter="@_quickFilter"
                             Loading="@isLoading"
                             LoadingProgressColor="Color.Primary"
                             Hover
                             MultiSelection="true"
                             SelectedItemsChanged="@SelectedItemsChanged"
                             Dense="true">
                    <ToolBarContent>
                        <MudSpacer />
                        <MudTextField Class="mt-1" Variant="Variant.Text" @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small"></MudTextField>
                    </ToolBarContent>
                    <Columns>
                        <SelectColumn T="BookingStackingGrid" />
                        <PropertyColumn Property="x => x.LastETD!.Value.ToString(format)" HeaderStyle="font-weight: bold;" />
                        <PropertyColumn Property="x => x.Vessel" HeaderStyle="font-weight: bold;" />
                        <PropertyColumn Property="x => x.Voyage" HeaderStyle="font-weight: bold;" />
                        <PropertyColumn Property="x => x.TransportCompany" HeaderStyle="font-weight: bold;" />
                        <PropertyColumn Property="x => x.POL" Title="POL" HeaderStyle="font-weight: bold;" />
                        <PropertyColumn Property="x => x.PoRef" HeaderStyle="font-weight: bold;" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="BookingStackingGrid" />
                    </PagerContent>
                </MudDataGrid>
            </MudItem>
        </MudGrid>
            }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="@_processing" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            @if (_processing)
            {
                <MudProgressCircular Color="Color.Primary" Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Loading</MudText>
            }
            else
            {
                <MudText>Update</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public int id { get; set; } = 0;

    private List<BookingStackingGrid> bookingStackingList = new();
    private List<TransportCompanyModel> transportcompanyList = new();
    private List<VesselModel> vesselList = new();

    private int seasonId = 0;
    private bool _processing = false;
    private Margin margin = Margin.Dense;
    private bool _resetValueOnEmptyText = true;
    private string _searchString;
    private bool _sortNameByLength;
    bool isLoading = true;
    List<BookingStackingGrid> selectedBooking = new();
    string format = "dd/MM/yyyy";

    private IEnumerable<TransportCompanyModel> options { get; set; } = new HashSet<TransportCompanyModel>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            seasonId = await localStorage.GetItemAsync<int>("season");

            var lst = new List<Task>();
            var bsAsync = _bookingService.GetBookingStackingAsync();

            lst.Add(bsAsync);

            await Task.WhenAll(lst);

            bookingStackingList = await bsAsync;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isLoading = false;
            Snackbar.Add("No se pudo cargar la informacion. Intenta nuevamente.", Severity.Error);
            StateHasChanged();
        }
        isLoading = false;
    }

    private async Task Submit()
    {

        _processing = true;

        var saved = await _bookingService.PutBookingStackingAsync(selectedBooking);

        _processing = false;
        if (!saved)
        {
            Snackbar.Add("Could not save. Please try again.", Severity.Error);
            return;
        }
        MudDialog.Close(true);
    }

    void Cancel() => MudDialog.Cancel();

    void SelectedItemsChanged(HashSet<BookingStackingGrid> items)
    {
        selectedBooking.Clear();

        foreach (var item in items)
        {
            selectedBooking.Add(item);
        }
    }

    private Func<BookingStackingGrid, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.Vessel.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            x.TransportCompany.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            x.POL.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };
    
    string dateFormat = "dd/MM/yyyy";
    string bound = "not set";

    private Snackbar _snackbar;

    void Show(string msg)
    {
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomCenter;
        _snackbar = Snackbar.Add(msg, Severity.Error);
    }
}
