@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject FreeDaysService _freedayService
@inject TransportCompanyService _transportcompanyService
@inject CountryService _countryService

@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            FreeDays
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <FormSkeleton Rows="3" />
        }
        else
        {
<MudForm @ref="form">

        <MudGrid>
            <MudItem xs="12">
                <MudGrid Justify="Justify.Center" Style="align-items: center;">
                    <MudItem xs="9">
                        <MudSelect Variant="Variant.Outlined" T="int" Label="Transport Company" @bind-Value="freeday.TransportCompanyId" Required="true" RequiredError="Transport Company is required!"
                                   ToStringFunc="@(id => transportcompanyList.FirstOrDefault(t => t.TransportCompanyId == id)?.TransportCompany)">
                            @foreach (var item in transportcompanyList)
                            {
                                <MudSelectItem T="int" Value="@item.TransportCompanyId">@item.TransportCompany</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="3">
                        <MudFab StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" Size="Size.Small" OnClick="@(() => TransportCompanyOpenDialog(new TransportCompanyModel()))" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="12">
                <MudGrid Justify="Justify.Center" Style="align-items: center;">
                    <MudItem xs="9">
                        <MudSelect Variant="Variant.Outlined" T="int" Label="Country" @bind-Value="freeday.CountryId" Required="true" RequiredError="Country is required!"
                                   ToStringFunc="@(id => countryList.FirstOrDefault(c => c.CountryId == id)?.Country)">
                            @foreach (var item in countryList)
                            {
                                <MudSelectItem T="int" Value="@item.CountryId">@item.Country</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="3">
                        <MudFab StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" Size="Size.Small" OnClick="@(() => CountryOpenDialog(new CountryModel()))" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="12">
                <MudTextField Variant="Variant.Outlined" T="int" @bind-Value="freeday.FreeDays" Label="Free Days" Required="true" RequiredError="Free days is required!" />
            </MudItem>
        </MudGrid>
            </MudForm>
            }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="@_processing" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public FreeDaysModel freeday { get; set; } = new FreeDaysModel();

    private List<TransportCompanyModel> transportcompanyList = new();
    private List<CountryModel> countryList = new();

    private bool _processing = false;
    private MudForm? form;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var lst = new List<Task>();

        //var freedaysAsync = _freedayService.GetAllAsync();
        var transportcompanyAsync = _transportcompanyService.GetAllAsync();
        var countryAsync = _countryService.GetAllAsync();

        lst.Add(transportcompanyAsync);
        lst.Add(countryAsync);

        await Task.WhenAll(lst);

        transportcompanyList = await transportcompanyAsync;
        countryList = await countryAsync;


        //freeday = await _freedayService.GetAsync(freeday.Id);
        StateHasChanged();
        isLoading = false;
    }

    private async Task Submit()
    {

        if (form is not null)
        {
            await form.Validate();
            if (!form.IsValid)
            {
                return;
            }
        }
        var x = new FreeDaysModel();

        _processing = true;

        if (freeday.Id == 0)
        {
            x = await _freedayService.PostAsync(freeday);
        }
        else
        {
            x = await _freedayService.PutAsync(freeday);
        }

        _processing = false;
        if (x == null)
        {
            Snackbar.Add("Could not save. Please try again.", Severity.Error);
            return;
        }
        MudDialog.Close(true);
    }

    void Cancel() => MudDialog.Cancel();

    private async Task TransportCompanyOpenDialog(TransportCompanyModel s)
    {
        var parameters = new DialogParameters<TransportCompanyForm> { { x => x.transportcompany, s } };
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseButton = true };
        var dialog = await DialogService.ShowAsync<TransportCompanyForm>("Shipping Company", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            transportcompanyList = await _transportcompanyService.GetAllAsync();
        }
    }

    private async Task CountryOpenDialog(CountryModel s)
    {
        var parameters = new DialogParameters<CountryForm> { { x => x.country, s } };
        DialogOptions options = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseButton = true };
        var dialog = await DialogService.ShowAsync<CountryForm>("Country", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            countryList = await _countryService.GetAllAsync();
        }
    }
}
