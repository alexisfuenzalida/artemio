@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject ISnackbar Snackbar
@inject CostItemService _costitemService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            CostItem
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <FormSkeleton Rows="3" />
        }
        else
        {
<MudForm @ref="form">

        <MudGrid>
            <MudItem xs="12">
                <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="costitem.CostItem" Label="CostItem" Required="true" RequiredError="CostItem is required!" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="costitem.GroupItem" Label="GroupItem" Required="true" RequiredError="GroupItem is required!" />
            </MudItem>
        </MudGrid>
            </MudForm>
            }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="@_processing" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public CostItemModel costitem { get; set; } = new CostItemModel();

    private bool _processing = false;
    private MudForm? form;
    private bool isLoading = false;

    private async Task Submit()
    {

        if (form is not null)
        {
            await form.Validate();
            if (!form.IsValid)
            {
                return;
            }
        }
        var x = new CostItemModel();

        _processing = true;

        if (costitem.CostItemId == 0)
        {
            x = await _costitemService.PostAsync(costitem);
        }
        else
        {
            x = await _costitemService.PutAsync(costitem);
        }

        _processing = false;
        if (x == null)
        {
            Snackbar.Add("Could not save. Please try again.", Severity.Error);
            return;
        }
        MudDialog.Close(true);
    }

    void Cancel() => MudDialog.Cancel();
}
