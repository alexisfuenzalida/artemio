@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject AgentEmbarqueService _agentService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @bd.BL - @bd.Container
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <FormSkeleton Rows="3" />
        }
        else
        {
<MudForm @ref="form">

        <MudGrid>
            <MudItem xs="12">
                <MudTextField Variant="Variant.Outlined" T="decimal" @bind-Value="bd.Comm" Label="Comm" Required="true" RequiredError="Comm is required!" TextChanged="Calculate" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Variant="Variant.Outlined" T="decimal" @bind-Value="bd.Rebate" Label="Rebate" Required="true" RequiredError="Rebate is required!" TextChanged="Calculate" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Variant="Variant.Outlined" T="decimal" @bind-Value="bd.RebateExp" Label="Rebate Exporter" Required="true" RequiredError="Rebate Exporter is required!" TextChanged="Calculate" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Variant="Variant.Outlined" T="decimal" @bind-Value="bd.Fee" Label="Fee" Required="true" RequiredError="Fee is required!" />
            </MudItem>
        </MudGrid>
            </MudForm>
            }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="@_processing" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public BookingDetailModel bd { get; set; } = new BookingDetailModel();

    private bool _processing = false;
    private MudForm? form;
    private bool isLoading = false;

    private void Calculate()
    {
        bd.Fee = bd.Comm + bd.Rebate - bd.RebateExp;
    }

    private async Task Submit()
    {

        if (form is not null)
        {
            await form.Validate();
            if (!form.IsValid)
            {
                return;
            }
        }
        MudDialog.Close(true);
    }

    void Cancel() => MudDialog.Cancel();
}
