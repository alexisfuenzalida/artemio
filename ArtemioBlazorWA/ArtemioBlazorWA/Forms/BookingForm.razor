                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3" xl="2" xxl="2">
                        <MudTextField Margin="margin" Variant="Variant.Outlined" T="string" Label="Voyage" @bind-Value="booking.Voyage" Clearable="true"/>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4" lg="3" xl="2" xxl="2">
                        <MudGrid Justify="Justify.Center" Style="align-items: center;">
                            <MudItem xs="9">
                                <MudTextField Margin="margin" Variant="Variant.Outlined" T="string" Label="Nro Contract" @bind-Value="booking.NroContract" Clearable="true" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudFab Margin="margin" StartIcon="@Icons.Material.Filled.Search" Color="Color.Info" Size="Size.Small" OnClick="@(() => ContractOpenDialog(booking.POLId,booking.LastPODId,booking.TransportCompanyId))" />
                            </MudItem>
                        </MudGrid>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4" lg="3" xl="2" xxl="2">
