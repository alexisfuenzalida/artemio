@using ArtemioBlazorWA.Services;
@using System.Globalization;

@inject AgentService _agentService
@inject AgentAduanaService _agentaduanaService
@inject AgentEmbarqueService _agentembarqueService
@inject BlIssuedService _blissuedService
@inject BookingService _bookingService
