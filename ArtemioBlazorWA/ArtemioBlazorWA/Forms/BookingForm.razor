    private void FillDownByColumn(BookingDetailModel source, string columnName)
    {
        var sourceIndex = listBookingDetails.IndexOf(source);
        if (sourceIndex < 0) return;

        var property = typeof(BookingDetailModel).GetProperty(columnName);
        if (property == null) return;

        var sourceValue = property.GetValue(source);

        // Copia el valor a las filas siguientes
        for (int i = sourceIndex + 1; i < listBookingDetails.Count; i++)
        {
            property.SetValue(listBookingDetails[i], sourceValue);
        }

        StateHasChanged();
        Show($"✓ {GetColumnDisplayName(columnName)} repeated!", Severity.Success);
    }

    // Método auxiliar para obtener nombre legible de la columna
    private string GetColumnDisplayName(string columnName)
    {
        return columnName switch
        {
            "ConsigneeId" => "Consignee",
            "NotifyId" => "Notify",
            "BL" => "BL",
            "Container" => "Container",
            "Cases" => "Cases",
            "StatusContainerId" => "Status",
            "Comment" => "Comment",
            _ => columnName
        };
    }

