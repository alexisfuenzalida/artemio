@inject BookingIncidenceService _bookingincidenceService
@inject CommodityService _commodityService
@inject ContainerTypeService _containertypeService
@inject ContractTypeService _contracttypeService
@inject IncotermService _incotermService
@inject IntermediaryService _intermediaryService
@inject PaymentConditionService _paymentconditionService
@inject PortService _portService
@inject ServiceService _serviceService
@inject ShipperService _shipperService
@inject StackingService _stackingService
@inject TransportCompanyService _transportcompanyService
