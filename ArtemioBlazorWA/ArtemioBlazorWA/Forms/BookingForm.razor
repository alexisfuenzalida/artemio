                                                 ToStringFunc="@(ag=> ag is null ? null : $"{ag.Agent}")"
                                                 CoerceText="false"
                                                 CoerceValue="false" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudFab Margin="margin" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" Size="Size.Small" OnClick="@(() => AgentAduanaOpenDialog(new AgentModel()))" />
                            </MudItem>
                        </MudGrid>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4" lg="3" xl="2" xxl="2">
