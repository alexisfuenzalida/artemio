                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3" xl="2" xxl="2">
                        <MudTextField Margin="margin" Variant="Variant.Outlined" T="DateTime?" Format="s" Label="Extra LAR" InputType="InputType.DateTimeLocal" @bind-Value="booking.ExtraLAR" Clearable="true"/>
                    </MudItem>
