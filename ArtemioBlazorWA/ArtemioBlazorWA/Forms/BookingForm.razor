    // allowClear: true when called from the user editing "Qty Containers Request" directly (0
    // should wipe the detail rows). false for the load-time sync of an existing booking, where
    // qty starting at 0 must not silently delete rows already saved for that booking.
    private void SyncContainerRows(bool allowClear = true)
    {
        var qty = booking.QtyContainers;
        if (qty <= 0)
        {
            if (allowClear)
            {
                listBookingDetails.Clear();
            }
            StateHasChanged();
            return;
        }

        if (allowClear && listBookingDetails.Count > qty)
        {
            listBookingDetails.RemoveRange(qty, listBookingDetails.Count - qty);
        }

        while (listBookingDetails.Count < qty)
        {
            var n = listBookingDetails.Count + 1;
            listBookingDetails.Add(new BookingDetailModel
            {
                BL = $"BL{n}",
                Container = $"CNT{n}",
                Cases = 0
            });
        }

        StateHasChanged();
    }

