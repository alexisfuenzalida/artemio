@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public int id { get; set; } = 0;

    private BookingModel booking = new BookingModel();
    private List<BookingDetailModel> listBookingDetails = new List<BookingDetailModel>();
    public BookingDetailModel bd = new();

    private List<AgentModel> agentList = new();
    private List<AgentModel> agentaduanaList = new();
    private List<AgentModel> agentembList = new();
    private List<BlIssuedModel> blissuedList = new();
    private List<CommodityModel> commodityList = new();
    private List<ContainerTypeModel> containertypeList = new();
    private List<ContractTypeModel> contracttypeList = new();
    private List<IncotermModel> incotermList = new();
    private List<IntermediaryModel> intermediaryList = new();
    private List<PaymentConditionModel> paymentconditionList = new();
    private List<PortModel> portList = new();
    private List<SeasonModel> seasonList = new();
    private List<ServiceModel> serviceList = new();
    private List<ShipperModel> shipperList = new();
    private List<TransportModel> transportList = new();
    private List<TransportCompanyModel> transportcompanyList = new();
    private List<VesselModel> vesselList = new();
    private List<WarehouseModel> warehouseList = new();

    private List<ConsigneeModel> consigneeList = new();
    private List<NotifyModel> notifyList = new();
    private List<StatusContainerModel> statuscontainerList = new();

    private int seasonId = 0;
    private bool _processing = false;
    private MudForm? form;
    private bool isLoading = true;
    private Margin margin = Margin.Dense;
    private bool _resetValueOnEmptyText = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            seasonId = await localStorage.GetItemAsync<int>("season");

            var lookups = await _bookingLookupService.LoadAsync();
            agentList = lookups.Agents;
            agentembList = lookups.AgentsEmbarque;
            agentaduanaList = lookups.AgentsAduana;
            blissuedList = lookups.BlIssued;
            commodityList = lookups.Commodities;
            containertypeList = lookups.ContainerTypes;
            contracttypeList = lookups.ContractTypes;
            incotermList = lookups.Incoterms;
            intermediaryList = lookups.Intermediaries;
            paymentconditionList = lookups.PaymentConditions;
            portList = lookups.Ports;
            serviceList = lookups.Services;
            shipperList = lookups.Shippers;
            transportList = lookups.Transports;
            transportcompanyList = lookups.TransportCompanies;
            vesselList = lookups.Vessels;
            warehouseList = lookups.Warehouses;
            consigneeList = lookups.Consignees;
            notifyList = lookups.Notifies;
            statuscontainerList = lookups.StatusContainers;

            tc = transportcompanyList.Where(t => t.TransportCompanyId == booking.TransportCompanyId).FirstOrDefault() ?? new TransportCompanyModel();

            if (id != 0)
            {
                booking = await _bookingService.GetAsync(id);

                AgentInputChange(booking.AgentId);
                AgentEmbInputChange(booking.AgentEmbarqueId);
                AgentAduanaInputChange(booking.AgentAduanaId);
                //BlIssuedInputChange(booking.BlIssuedId);
                CommodityInputChange(booking.CommodityId);
                ContainerTypeInputChange(booking.ContainerTypeId);
                ContractTypeInputChange(booking.ContractTypeId);
                //IncotermInputChange(booking.AgentId);
                IntermediaryInputChange(booking.IntermediaryId);
                //PaymentConditionInputChange(booking.AgentId);

                TransportInputChange(booking.TransportId);
                POLInputChange(booking.POLId);
                PODInputChange(booking.LastPODId);

                TransportCompanyInputChange(booking.TransportCompanyId);
