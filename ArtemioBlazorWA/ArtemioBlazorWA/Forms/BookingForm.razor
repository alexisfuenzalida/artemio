                                 @bind-Value="wa"
                                                          Clearable
                                                          ResetValueOnEmptyText="_resetValueOnEmptyText"
                                                  ToStringFunc="@(se=> se is null ? null : $"{se.Warehouse}")"
                                                  
                                                  CoerceText="false"
                                                  CoerceValue="false" />

                                                  <!--
                                <MudSelect Margin="margin" Variant="Variant.Outlined" T="int" Label="Depot" @bind-Value="booking.WarehouseId" Required="true" RequiredError="Depot is required!"
                                           ToStringFunc="@(id => warehouseList.FirstOrDefault(w => w.WarehouseId == id)?.Warehouse)">
                                    @foreach (WarehouseModel item in warehouseList)
                                    {
                                        <MudSelectItem T="int" Value="@item.WarehouseId">@item.Warehouse</MudSelectItem>
                                    }
                                </MudSelect>
                                                  -->
                            </MudItem>
                            <MudItem xs="3">
                                <MudFab Margin="margin" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" Size="Size.Small" OnClick="@(() => WarehouseOpenDialog(new WarehouseModel()))" />
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                     <MudItem xs="12" sm="6" md="4" lg="3" xl="2" xxl="2">
                         <MudGrid Justify="Justify.Center" Style="align-items: center;">
                             <MudItem xs="9">
                                 <MudTextField Margin="margin" Variant="Variant.Outlined" T="DateTime?" Format="s" Label="StackingFrom" InputType="InputType.DateTimeLocal" @bind-Value="booking.StackingFrom" Clearable="true" />
                             </MudItem>
