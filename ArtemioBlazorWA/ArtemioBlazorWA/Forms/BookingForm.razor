                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3" xl="2" xxl="2">
                        <MudTextField Margin="margin" @bind-Value="booking.PoRef" Variant="Variant.Outlined" T="string" Label="PO / Ref." Clearable="true" />
                    </MudItem>
