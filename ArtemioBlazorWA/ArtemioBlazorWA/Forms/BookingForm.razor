    private async Task Submit()
    {

        if (form is not null)
        {
            await form.Validate();
            if (!form.IsValid)
            {
                Show("Faltan datos obligatorios. Revisa los campos marcados en rojo para poder guardar el booking.", Severity.Warning);
                return;
            }
        }
        _processing = true;
        var x = new BookingModel();

        #region Valid Null
        if(tc==null)
        {
            tc = new TransportCompanyModel();
        }
        booking.TransportCompanyId=tc.TransportCompanyId;

        if(ag==null)
        {
            ag = new AgentModel();
        }
        booking.AgentId=ag.AgentId;

        if (agEmb == null)
        {
            agEmb = new AgentModel();
        }
        booking.AgentEmbarqueId = agEmb.AgentId;

        if (agd == null)
        {
            agd = new AgentModel();
        }
        booking.AgentAduanaId=agd.AgentId;

        if(inter==null)
        {
            inter = new IntermediaryModel();
        }
        booking.IntermediaryId=inter.IntermediaryId;

        if(ct==null)
        {
            ct = new ContractTypeModel();
        }
        booking.ContractTypeId = ct.ContractTypeId;

        if (sh == null)
        {
            sh = new ShipperModel();
        }
        booking.ShipperId=sh.ShipperId;

        if(se==null)
        {
            se = new ServiceModel();
        }
        booking.ServiceId = se.ServiceId;

        if(ve==null)
        {
            ve = new VesselModel();
        }
        booking.VesselId = ve.VesselId;

        if(wa==null)
        {
            wa = new WarehouseModel();
        }
        booking.WarehouseId = wa.WarehouseId;

        if(pol==null)
        {
            pol = new PortModel();
        }
        booking.POLId = pol.PortId;

        if(pod==null)
        {
            pod = new PortModel();
        }
        booking.LastPODId = pod.PortId;
        booking.OriginalPODId=pod.PortId;

        if(cont==null)
        {
            cont = new ContainerTypeModel();
        }
        booking.ContainerTypeId = cont.ContainerTypeId;

        if(com==null)
        {
            com = new CommodityModel();
        }
        booking.CommodityId=com.CommodityId;

        if (tra == null)
        {
            tra = new TransportModel();
        }
        booking.TransportId = tra.TransportId;

        if(bi==null)
        {
            bi = new BlIssuedModel();
        }
        booking.BlIssuedId = bi.BlIssuedId;

        if (it == null)
        {
            it = new IncotermModel();
        }
        booking.IncotermId = it.IncotermId;

        if (pc== null)
        {
            pc = new PaymentConditionModel();
        }
        booking.PaymentConditionId = pc.PaymentConditionId;

        #endregion

        booking.QtyContainersReal = listBookingDetails.Count(bd => bd.StatusContainerId == 1);
        booking.HsCode ??= "";
        booking.Temperature ??= "";

        string error;
        if (booking.BookingId == 0)
        {
            booking.SeasonId = seasonId;
            booking.LastPODId = booking.OriginalPODId;

            (x, error) = await _bookingService.PostResultAsync(booking);
        }
        else
        {
            (x, error) = await _bookingService.PutResultAsync(booking);
        }

        if (x == null)
        {
            Snackbar.Add(string.IsNullOrWhiteSpace(error) ? "Could not save booking" : error, Severity.Error);
            _processing = false;
            return;
        }

        await _bookingdtlService.DeleteAsync(x.BookingId);

        foreach(var item in listBookingDetails)
        {
            item.BookingId = x.BookingId;
            item.BL ??= "";
            item.Container ??= "";
            item.Comment ??= "";
            item.SendFreeDaysComment ??= "";

            var resp = await _bookingdtlService.PostAsync(item);
            if (resp == null)
            {
                Snackbar.Add("Booking saved, but a container/BL line could not be stored", Severity.Error);
                _processing = false;
                return;
            }
        }

        _processing=false;
        MudDialog.Close(true);
    }

