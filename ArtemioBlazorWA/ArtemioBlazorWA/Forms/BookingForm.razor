        // Si no hay valor de búsqueda, retorna todos los consignees
        if (string.IsNullOrEmpty(value))
            return notifyList;

        // Filtra los consignees basado en el texto de búsqueda
        return notifyList
            .Where(x => x.Notify.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private void NotifyChanged(NotifyModel? newValue, BookingDetailModel bookingDetail)
    {
        if (newValue != null)
        {
            bookingDetail.NotifyId = newValue.NotifyId;
            // Aquí puedes agregar lógica adicional si necesitas hacer algo cuando cambia el consignee
            StateHasChanged();
        }
    }

    private TransportCompanyModel tc = new();
    async void TransportCompanyInputChange(int value)
    {
        booking.TransportCompanyId = value;

        serviceList = await _transportcompanyserviceService.GetAllAssignedAsync(value);
        tc = transportcompanyList.Where(e => e.TransportCompanyId == value).FirstOrDefault();
    }

    // Fired when the user actually picks/clears "Ship. Company" in the form (as opposed to
    // TransportCompanyInputChange above, which only runs once when an existing booking is
    // loaded for edit). Without this, Service never reloaded for the chosen carrier, so that
    // dropdown stayed empty on new bookings and stale after changing the carrier. POL/POD are
    // intentionally NOT scoped to the carrier: they list every port (see SearchPOL/SearchPOD).
    private async Task OnTransportCompanySelected(TransportCompanyModel? value)
    {
        tc = value;
        var id = value?.TransportCompanyId ?? 0;
        booking.TransportCompanyId = id;

        serviceList = await _transportcompanyserviceService.GetAllAssignedAsync(id);
    }
