@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject ISnackbar Snackbar
@inject TransportCompanyItemService _transportcompanyitemService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Shipping Company - @tc.TransportCompany
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <FormSkeleton Rows="8" Columns="4" />
        }
        else
        {

        <MudGrid>
            <MudItem xs="12">
                <MudCard Elevation="2">
                    <MudCardHeader Style="background-color: var(--mud-palette-background);">
                        <CardHeaderContent>
                            <MudText Typo="Typo.body1">Items</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudButton Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Color="Color.Primary"
                                       OnClick="@(() => AddRow(new TransportCompanyItemModel()))">
                                Add Row
                            </MudButton>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudItem xs="12">
                            <MudTable Items="@items" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Primary">
                                <HeaderContent>
                                    <MudTh></MudTh>
                                    <MudTh></MudTh>
                                    <MudTh></MudTh>
                                    <MudTh></MudTh>
                                    <MudTh></MudTh>
                                    <MudTh></MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Service">
                                        <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" T="string" Label="Service" @bind-Value="context.Service">
                                            <MudSelectItem Value="@("Export")" />
                                            <MudSelectItem Value="@("Export/Import")" />
                                            <MudSelectItem Value="@("Import")" />
                                        </MudSelect>
                                    </MudTd>
                                    <MudTd DataLabel="Item">
                                        <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="context.Item" Label="Item" />
                                    </MudTd>
                                    <MudTd DataLabel="Currency">
                                        <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" T="string" Label="Type" @bind-Value="context.Currency">
                                            <MudSelectItem Value="@("USD")" />
                                            <MudSelectItem Value="@("CLP")" />
                                        </MudSelect>
                                    </MudTd>
                                    <MudTd DataLabel="Rate">
                                        <MudNumericField T="decimal" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="context.Rate" Label="Rate" />
                                    </MudTd>
                                    <MudTd DataLabel="Tax">
                                        <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" T="string" Label="Type" @bind-Value="context.Tax">
                                            <MudSelectItem Value="@("+IVA")" />
                                        </MudSelect>
                                    </MudTd>
                                    <MudTd DataLabel="Concept">
                                        <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" T="string" Label="Type" @bind-Value="context.Concept">
                                            <MudSelectItem Value="@("Contenedor")" />
                                        </MudSelect>
                                    </MudTd>
                                    <MudTd DataLabel="Type">
                                        <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" T="string" Label="Type" @bind-Value="context.Type">
                                            <MudSelectItem Value="@("Factura Afecta")" />
                                            <MudSelectItem Value="@("Factura Excenta")" />
                                        </MudSelect>
                                    </MudTd>
                                    <MudTd DataLabel="Remove">
                                        <MudFab StartIcon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveDtl(context))" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudItem>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
            }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="@_processing" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public TransportCompanyModel tc { get; set; } = new();

    private List<TransportCompanyItemModel> items = new();
    private bool _processing = false;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {

        items = await _transportcompanyitemService.GetAsync(tc.TransportCompanyId);
        isLoading = false;
    }
    private void AddRow(TransportCompanyItemModel bi)
    {
        items.Add(bi);
    }

    private void RemoveDtl(TransportCompanyItemModel bi)
    {
        items.Remove(bi);
    }

    private async Task Submit()
    {
        var x = new TransportCompanyItemModel();

        _processing = true;

        await _transportcompanyitemService.DeleteAsync(tc.TransportCompanyId);

        foreach (var item in items)
        {
            item.TransportCompanyId = tc.TransportCompanyId;
            x = await _transportcompanyitemService.PostAsync(item);
        }

        _processing = false;
        if (x == null)
        {
            Snackbar.Add("Could not save. Please try again.", Severity.Error);
            return;
        }
        MudDialog.Close(true);
    }

    void Cancel() => MudDialog.Cancel();
}
