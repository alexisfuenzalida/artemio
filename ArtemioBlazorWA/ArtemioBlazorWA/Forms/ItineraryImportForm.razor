@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;
@using Microsoft.AspNetCore.Components.Forms;

@inject ItineraryService _itineraryService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Import Itineraries (Wan Hai)
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (result == null)
        {
            <MudStack Spacing="3">
                <MudText Typo="Typo.body2">
                    Selecciona el archivo Excel de "Captura Masiva de Itinerarios - Wan Hai" (hoja "Captura Semanal").
                </MudText>
                <MudFileUpload T="IBrowserFile" Accept=".xlsx" FilesChanged="OnFileSelected">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload">
                            Seleccionar archivo
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                @if (selectedFile != null)
                {
                    <MudText Typo="Typo.body2">@selectedFile.Name</MudText>
                }
            </MudStack>
        }
        else
        {
            <MudStack Spacing="3">
                <MudAlert Severity="@(result.Errors.Count > 0 ? Severity.Warning : Severity.Success)">
                    Importados: @result.Imported &nbsp;|&nbsp; Omitidos (ya existian): @result.Skipped &nbsp;|&nbsp; Filas con datos: @result.TotalRows
                </MudAlert>
                @if (result.Errors.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2">Errores</MudText>
                    <MudList T="ItineraryImportRowError" Style="max-height: 300px; overflow-y: auto;">
                        @foreach (var error in result.Errors)
                        {
                            <MudListItem Text="@($"Fila {error.Row}: {error.Message}")" Icon="@Icons.Material.Filled.ErrorOutline" IconColor="Color.Error" />
                        }
                    </MudList>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        @if (result == null)
        {
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Disabled="@(selectedFile == null || _processing)" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
                @if (_processing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Importing</MudText>
                }
                else
                {
                    <MudText>Import</MudText>
                }
            </MudButton>
        }
        else
        {
            <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Primary">Close</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    private IBrowserFile? selectedFile;
    private ItineraryImportResultModel? result;
    private bool _processing = false;

    private void OnFileSelected(IBrowserFile file)
    {
        selectedFile = file;
    }

    private async Task Submit()
    {
        if (selectedFile == null)
        {
            return;
        }

        _processing = true;

        var seasonId = await localStorage.GetItemAsync<int>("season");
        var (data, error) = await _itineraryService.PostImportAsync(selectedFile, seasonId);

        _processing = false;

        if (data == null)
        {
            Show(string.IsNullOrWhiteSpace(error) ? "No se pudo importar el archivo." : error, Severity.Error);
            return;
        }

        result = data;
    }

    private void Close() => MudDialog.Close(true);

    private void Cancel() => MudDialog.Cancel();

    private Snackbar _snackbar;

    private void Show(string msg, Severity severity)
    {
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomCenter;
        _snackbar = Snackbar.Add(msg, severity);
    }
}
