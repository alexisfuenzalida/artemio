@using ArtemioBlazorWA.Models;
@using ArtemioBlazorWA.Services;

@inject ISnackbar Snackbar
@inject InvoiceService _invoiceService
@inject InvoiceDetailService _invoiceDetailService
@inject PreInvoiceService _preInvoiceService
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Invoice
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <FormSkeleton Rows="4" Columns="2" />
        }
        else
        {
<MudForm @ref="form">
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker Margin="margin" Variant="Variant.Outlined" Editable="true" Label="Date" @bind-Date="invoice.Date" DateFormat="@dateFormat" Clearable="true" Required="true" RequiredError="Date is required!" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect Margin="margin" Variant="Variant.Outlined" T="string" Label="Type" Value="@invoice.Type" ValueChanged="TypeChanged" Required="true" RequiredError="Type is required!">
                        @foreach (var type in Types)
                        {
                            <MudSelectItem T="string" Value="@type">@type</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField Margin="margin" Variant="Variant.Outlined" T="string" Label="Number" @bind-Value="invoice.Number" Required="true" RequiredError="Number is required!" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField Margin="margin" Variant="Variant.Outlined" T="decimal" Label="Amount" @bind-Value="invoice.Amount" Format="N2" HideSpinButtons="true" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Margin="margin" Variant="Variant.Outlined" T="string" Label="Observation" @bind-Value="invoice.Observation" Lines="3" Clearable="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.body1">Bookings</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudButton Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@(string.IsNullOrWhiteSpace(invoice.Type))"
                                           OnClick="AddRow">
                                    Add Booking
                                </MudButton>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudTable Items="@listDetails" Hover="true" Breakpoint="Breakpoint.None" Dense="true">
                                <HeaderContent>
                                    <MudTh>Booking</MudTh>
                                    <MudTh>Amount</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Booking">
                                        <MudAutocomplete T="PreInvoiceModel"
                                                         Margin="margin"
                                                         Variant="Variant.Outlined"
                                                         Value="@(availableBookings.FirstOrDefault(c => c.BookingId == context.BookingId) ?? ToPreInvoice(context))"
                                                         ValueChanged="@(newValue => BookingChanged(newValue, context))"
                                                         SearchFunc="@(async (value, token) => await SearchBooking(value, context))"
                                                         ToStringFunc="@(c => c == null ? null : c.NroBooking)"
                                                         Label="Nro Booking"
                                                         ResetValueOnEmptyText="true"
                                                         CoerceText="false"
                                                         CoerceValue="false"
                                                         Clearable="true" />
                                    </MudTd>
                                    <MudTd DataLabel="Amount">
                                        <MudNumericField Margin="margin"
                                                         Variant="Variant.Outlined"
                                                         T="decimal"
                                                         Value="context.Amount"
                                                         ValueChanged="@(v => AmountChanged(context, v))"
                                                         HideSpinButtons="true"
                                                         Format="N2"
                                                         Immediate="true" />
                                    </MudTd>
                                    <MudTd DataLabel="Remove">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => RemoveRow(context))" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="@_processing" OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public InvoiceModel invoice { get; set; } = new InvoiceModel();

    private static readonly string[] Types =
    {
        "INet",
        "IRebate",
        "IFeeShipper",
        "IFeeIntermedary",
        "IFeeArtemio",
        "IComm",
        "ILAR",
        "ILARDoc"
    };

    private List<InvoiceDetailModel> listDetails = new();
    private List<PreInvoiceModel> availableBookings = new();
    private bool _processing = false;
    private MudForm? form;
    private bool isLoading = true;
    private Margin margin = Margin.Dense;
    private string dateFormat = "dd/MM/yyyy";
    private int seasonId = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            seasonId = await localStorage.GetItemAsync<int>("season");

            if (invoice.InvoiceId != 0)
            {
                invoice = await _invoiceService.GetAsync(invoice.InvoiceId) ?? invoice;
                listDetails = await _invoiceDetailService.GetAsync(invoice.InvoiceId) ?? new List<InvoiceDetailModel>();
            }

            if (invoice.Date == null)
            {
                invoice.Date = DateTime.Today;
            }

            await LoadAvailableBookings();
            RecalcAmount();
            StateHasChanged();
        }
        catch (Exception)
        {
            await Task.Delay(500);
        }
        isLoading = false;
    }

    private async Task LoadAvailableBookings()
    {
        if (string.IsNullOrWhiteSpace(invoice.Type) || seasonId == 0)
        {
            availableBookings = new List<PreInvoiceModel>();
            return;
        }

        availableBookings = await _preInvoiceService.GetBySeasonAndTypeAsync(seasonId, invoice.Type, invoice.InvoiceId)
            ?? new List<PreInvoiceModel>();
    }

    private async Task TypeChanged(string type)
    {
        invoice.Type = type ?? "";
        listDetails = new List<InvoiceDetailModel>();
        invoice.Amount = 0;
        await LoadAvailableBookings();
        StateHasChanged();
    }

    private void AddRow()
    {
        listDetails.Add(new InvoiceDetailModel());
        StateHasChanged();
    }

    private void RemoveRow(InvoiceDetailModel row)
    {
        listDetails.Remove(row);
        RecalcAmount();
        StateHasChanged();
    }

    private PreInvoiceModel? ToPreInvoice(InvoiceDetailModel row)
    {
        if (row.BookingId == 0)
        {
            return null;
        }

        return new PreInvoiceModel
        {
            BookingId = row.BookingId,
            NroBooking = row.NroBooking,
            Amount = row.Amount,
            Type = invoice.Type
        };
    }

    private Task<IEnumerable<PreInvoiceModel>> SearchBooking(string value, InvoiceDetailModel row)
    {
        var used = listDetails.Where(d => d != row && d.BookingId != 0).Select(d => d.BookingId).ToHashSet();
        IEnumerable<PreInvoiceModel> source = availableBookings.Where(p => !used.Contains(p.BookingId));

        if (row.BookingId != 0 && source.All(p => p.BookingId != row.BookingId))
        {
            source = source.Append(ToPreInvoice(row)!);
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult(source);
        }

        return Task.FromResult(source.Where(x =>
            x.NroBooking.Contains(value, StringComparison.InvariantCultureIgnoreCase)));
    }

    private void BookingChanged(PreInvoiceModel? selected, InvoiceDetailModel row)
    {
        if (selected == null)
        {
            row.BookingId = 0;
            row.NroBooking = "";
            row.Amount = 0;
        }
        else
        {
            row.BookingId = selected.BookingId;
            row.NroBooking = selected.NroBooking;
            row.Amount = selected.Amount;
        }

        RecalcAmount();
        StateHasChanged();
    }

    private void AmountChanged(InvoiceDetailModel row, decimal value)
    {
        row.Amount = value;
        RecalcAmount();
        StateHasChanged();
    }

    private void RecalcAmount()
    {
        invoice.Amount = listDetails.Sum(x => x.Amount);
    }

    private async Task Submit()
    {

        if (form is not null)
        {
            await form.Validate();
            if (!form.IsValid)
            {
                return;
            }
        }
        if (invoice.Date == null)
        {
            Show("Date is required!", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(invoice.Type))
        {
            Show("Type is required!", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(invoice.Number))
        {
            Show("Number is required!", Severity.Error);
            return;
        }

        var details = listDetails.Where(x => x.BookingId != 0).ToList();
        if (details.Count == 0)
        {
            Show("Add at least one booking.", Severity.Error);
            return;
        }

        RecalcAmount();
        invoice.Observation ??= "";

        _processing = true;

        InvoiceModel saved;
        if (invoice.InvoiceId == 0)
        {
            saved = await _invoiceService.PostAsync(invoice);
        }
        else
        {
            saved = await _invoiceService.PutAsync(invoice);
        }

        if (saved == null)
        {
            _processing = false;
            Snackbar.Add("Could not save. Please try again.", Severity.Error);
            return;
        }

        await _invoiceDetailService.DeleteAsync(saved.InvoiceId);

        foreach (var item in details)
        {
            item.InvoiceId = saved.InvoiceId;
            await _invoiceDetailService.PostAsync(item);
        }

        _processing = false;
        MudDialog.Close(true);
    }

    void Cancel() => MudDialog.Cancel();

    private Snackbar? _snackbar;

    void Show(string msg, Severity severity)
    {
        _snackbar = Snackbar.Add(msg, severity);
    }
}
