<MudPaper Class="pa-4 my-2" Elevation="0" Outlined="true">
    <MudStack Spacing="3">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudSkeleton Width="160px" Height="28px" Animation="Animation.Wave" />
            <MudSkeleton Width="220px" Height="40px" Animation="Animation.Wave" />
        </MudStack>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="42px" Animation="Animation.Wave" />
        @for (var i = 0; i < Rows; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="36px" Animation="Animation.Wave" />
        }
        <MudStack Row Justify="Justify.FlexEnd">
            <MudSkeleton Width="240px" Height="32px" Animation="Animation.Wave" />
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public int Rows { get; set; } = 8;
}
