<MudPaper Class="d-flex flex-column align-center justify-center gap-3 pa-12 my-6" Elevation="0" Outlined="true">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Default" />
    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default">@Message</MudText>
    @if (!string.IsNullOrWhiteSpace(ActionLabel) && OnAction.HasDelegate)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Class="mt-2"
                   OnClick="OnAction">
            @ActionLabel
        </MudButton>
    }
</MudPaper>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Inbox;
    [Parameter] public string Message { get; set; } = "No hay resultados.";
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
}
