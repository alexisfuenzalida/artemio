# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" a un repositorio git.

DB_HOST=artemio.cl
DB_PORT=3306
DB_NAME=afuenzal_artemio
DB_USER=afuenzal_ti
DB_PASSWORD=

# "Preferred" en la cadena original -> intenta SSL, si no está disponible usa conexión normal.
# mysql2 no soporta "preferred" nativo: dejamos SSL activado con verificación laxa.
# Si falla la conexión, prueba cambiando esto a "false".
DB_SSL=true

# Por seguridad, el servidor bloquea por defecto cualquier consulta que no sea de lectura
# (INSERT, UPDATE, DELETE, DROP, ALTER, CREATE, TRUNCATE, REPLACE, GRANT, REVOKE).
# Cámbialo a "true" solo si realmente necesitas que Claude pueda escribir en producción.
ALLOW_WRITE=false

# Máximo de filas que se devuelven en una sola consulta, para no saturar el contexto.
MAX_ROWS=500

# --- Solo para correrlo como servidor remoto (ej. en cPanel con "Setup Node.js App") ---
# "stdio" (por defecto) para Claude Desktop/Code local. "http" para exponerlo por red.
MCP_TRANSPORT=stdio

# Puerto HTTP cuando MCP_TRANSPORT=http. cPanel normalmente inyecta su propio PORT
# a través de la app Node.js, así que puedes dejar esto sin usar en ese caso.
PORT=3000

# Token secreto que debe mandar el cliente como "Authorization: Bearer <token>"
# cuando MCP_TRANSPORT=http. Obligatorio en ese modo. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=
